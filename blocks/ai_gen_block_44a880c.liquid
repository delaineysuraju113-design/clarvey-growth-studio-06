{% doc %}
  @prompt
    help build me a category page listing our products for customers. cean simple and acces to add photos for each one. now give me acces to add images for each product and also make it fit well with the screen and page., the products are Fresh products, meats & seafood, oil & cooking,pantry, rice & grains and spices & seasoning 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-category-grid-{{ ai_gen_id }} {
    display: block;
    width: {{ block.settings.desktop_width_percent }}%;
    max-width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-category-grid__container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-category-grid__header-{{ ai_gen_id }} {
    text-align: {{ block.settings.heading_alignment }};
    margin-bottom: {{ block.settings.heading_spacing }}px;
  }

  .ai-category-grid__title-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
  }

  .ai-category-grid__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat({{ block.settings.columns_desktop }}, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ai-category-grid__item-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    border-radius: {{ block.settings.card_border_radius }}px;
    background-color: {{ block.settings.card_background }};
    transition: transform 0.3s ease;
  }

  .ai-category-grid__item-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-category-grid__link-{{ ai_gen_id }} {
    display: block;
    text-decoration: none;
    color: inherit;
  }

  .ai-category-grid__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: {{ block.settings.image_aspect_ratio }}%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-category-grid__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-category-grid__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-category-grid__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-category-grid__content-{{ ai_gen_id }} {
    padding: {{ block.settings.card_padding }}px;
    text-align: {{ block.settings.text_alignment }};
  }

  .ai-category-grid__category-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.category_title_size }}px;
    color: {{ block.settings.category_title_color }};
    margin: 0 0 8px 0;
    font-weight: 600;
  }

  .ai-category-grid__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  @media screen and (max-width: 989px) {
    .ai-category-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_tablet }}, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-category-grid__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);
      gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-category-grid__title-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.75 }}px;
    }

    .ai-category-grid__category-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.category_title_size | times: 0.9 }}px;
    }

    .ai-category-grid__description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<category-grid-{{ ai_gen_id }} class="ai-category-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-category-grid__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <div class="ai-category-grid__header-{{ ai_gen_id }}">
        <h2 class="ai-category-grid__title-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      </div>
    {% endif %}

    <ul class="ai-category-grid__grid-{{ ai_gen_id }}">
      {% for i in (1..12) %}
        {% liquid
          assign category_enabled_key = 'category_' | append: i | append: '_enabled'
          assign category_image_key = 'category_' | append: i | append: '_image'
          assign category_title_key = 'category_' | append: i | append: '_title'
          assign category_description_key = 'category_' | append: i | append: '_description'
          assign category_link_key = 'category_' | append: i | append: '_link'

          assign category_enabled = block.settings[category_enabled_key]
          assign category_image = block.settings[category_image_key]
          assign category_title = block.settings[category_title_key]
          assign category_description = block.settings[category_description_key]
          assign category_link = block.settings[category_link_key]
        %}

        {% if category_enabled %}
          <li class="ai-category-grid__item-{{ ai_gen_id }}">
            {% if category_link != blank %}
              <a href="{{ category_link }}" class="ai-category-grid__link-{{ ai_gen_id }}">
            {% endif %}

            <div class="ai-category-grid__image-wrapper-{{ ai_gen_id }}">
              {% if category_image %}
                <img
                  src="{{ category_image | image_url: width: 600 }}"
                  alt="{{ category_image.alt | escape }}"
                  loading="lazy"
                  width="600"
                  height="{{ 600 | times: block.settings.image_aspect_ratio | divided_by: 100 }}"
                  class="ai-category-grid__image-{{ ai_gen_id }}"
                >
              {% else %}
                <div class="ai-category-grid__placeholder-{{ ai_gen_id }}">
                  {{ 'collection-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
            </div>

            <div class="ai-category-grid__content-{{ ai_gen_id }}">
              {% if category_title != blank %}
                <h3 class="ai-category-grid__category-title-{{ ai_gen_id }}">{{ category_title }}</h3>
              {% endif %}
              {% if category_description != blank %}
                <p class="ai-category-grid__description-{{ ai_gen_id }}">{{ category_description }}</p>
              {% endif %}
            </div>

            {% if category_link != blank %}
              </a>
            {% endif %}
          </li>
        {% endif %}
      {% endfor %}
    </ul>
  </div>
</category-grid-{{ ai_gen_id }}>

<script>
  (function() {
    class CategoryGrid{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.style.display = 'block';
      }
    }

    customElements.define('category-grid-{{ ai_gen_id }}', CategoryGrid{{ ai_gen_id }});
  })();
</script>

